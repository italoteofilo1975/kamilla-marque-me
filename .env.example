# Chave da API da Anthropic (OBRIGATÓRIA) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Padrão: claude-opus-4-8
# ANTHROPIC_MODEL=claude-opus-4-8

# Token da API do QEdu (OPCIONAL) — habilita a consulta direta de IDEB/Censo.
# Sem ele, o agente usa busca web nas fontes oficiais (INEP/QEdu).
# QEDU_API_TOKEN=
